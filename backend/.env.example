# Valores de EXEMPLO. Rode `cp .env.example .env` e defina os seus.

# MySQL
MYSQL_DATABASE=quotare
MYSQL_USER=cotacoes
MYSQL_PASSWORD=troque-em-dev-local
MYSQL_ROOT_PASSWORD=troque-em-dev-local

# integracao-service (client do cotacoes-service)
INTEGRACAO_SERVICE_URL=http://integracao-service:8082
INTEGRACAO_SERVICE_CONNECT_TIMEOUT=3000
INTEGRACAO_SERVICE_READ_TIMEOUT=5000

# Ingestão agendada (cotacoes-service)
INGESTAO_CRON=0 0/15 * * * ?
INGESTAO_JANELA_INICIAL=P30D

# CORS (Traefik)
CORS_ALLOWED_ORIGINS=http://localhost:5173
